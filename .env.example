# URL do complemento mobile em server/. No aparelho, use o IP LAN ou HTTPS.
# A API Koda original e as chaves Supabase ficam em server/.env.
EXPO_PUBLIC_API_URL=http://localhost:3001/api
EXPO_PUBLIC_DEMO_MODE=false

# ESP32-DHT11: valores encontrados em app-koda/src/bleDeviceConfig.ts.
# Só altere se o firmware/sensor for diferente.
EXPO_PUBLIC_BLE_DEVICE_NAME=ESP32-DHT11
EXPO_PUBLIC_BLE_DEVICE_ID=
EXPO_PUBLIC_BLE_SERVICE_UUID=11111111-2222-3333-4444-555555555555
EXPO_PUBLIC_BLE_CHARACTERISTIC_UUID=aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee

# Opcional: substitui o telefone cadastrado no centro logístico.
EXPO_PUBLIC_CENTRAL_PHONE=

# Opcional: mapa nativo Android. Restrinja a chave ao pacote/assinatura do app.
# iOS usa Apple Maps, sem chave. Alterar exige novo build nativo.
GOOGLE_MAPS_ANDROID_API_KEY=
