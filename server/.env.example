# Same API used by koda-web. Include /api. No trailing /users.
KODA_API_URL=http://localhost:3000/api

# SAME Supabase project used by koda-server. Server only; never EXPO_PUBLIC_*.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=
# Accepts sb_secret_... or the legacy service_role key. Never use anon here.

PORT=3001
CORS_ORIGINS=http://localhost:8097,http://localhost:8096,http://localhost:8081,http://localhost:8093

# Optional: driving route, distance and ETA within the app.
# Without this token, external Google Maps/Waze navigation still works.
MAPBOX_ACCESS_TOKEN=
